<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verdefondo2"
    tools:context=".InicioDatosActivity">

    <LinearLayout
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_meu" />

        <TextView
            android:id="@+id/tvTituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="INICIO"
            android:textColor="@color/black"
            android:textSize="48dp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_libreta" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Balance actual"
        android:textColor="@color/black"
        android:textSize="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior" />

    <LinearLayout
        android:id="@+id/layoutDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo">

        <TextView
            android:id="@+id/tvDineroTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Dinero total: $0"
            android:textColor="@color/black"
            android:textSize="24dp" />

        <TextView
            android:id="@+id/tvTusAhorros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Tus ahorros: $0"
            android:textColor="@color/black"
            android:textSize="24dp" />

        <TextView
            android:id="@+id/tvIngresosRecientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Ingresos recientes: $0"
            android:textColor="@color/black"
            android:textSize="24dp" />

        <TextView
            android:id="@+id/tvGastosRecientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos recientes: $0"
            android:textColor="@color/black"
            android:textSize="24dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAgregarCentral"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="40dp"
        android:text="agregar"
        android:textAllCaps="false"
        android:textColor="@color/fucsia3"
        android:textSize="24dp"
        app:backgroundTint="@color/verde3"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDatos" />

    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/verde2"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/verdefondo"
            android:contentDescription="Inicio"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_casa"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/navAgregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Agregar"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_mas"
            app:tint="@color/verde1" />

        <ImageButton
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Perfil"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_persona"
            app:tint="@color/verde1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>