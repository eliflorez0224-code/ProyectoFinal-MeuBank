<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iniciosesion"
    android:background="@color/verdefondo3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:textSize="28dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etCorreoinicio"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Correo"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/etClaveinicio"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Contraseña (mínimo 6 caracteres)"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/btnIngresarinicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ingresar"
        android:backgroundTint="@color/fucsia1" />

    <TextView
        android:id="@+id/tvEstadoinicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="18dp" />

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Volver"
        android:backgroundTint="@color/fucsia1"
        android:textColor="@color/white" />

</LinearLayout>