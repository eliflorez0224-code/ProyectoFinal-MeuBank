<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verdefondo2"
    tools:context=".NuevoGastoActivity">

    <TextView
        android:id="@+id/tvTituloPantalla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="Nuevo Gasto"
        android:textColor="@color/black"
        android:textSize="40dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/Meu2"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icono_meu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloPantalla" />

    <LinearLayout
        android:id="@+id/layoutNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/Meu2"
        app:layout_constraintTop_toTopOf="@id/Meu2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreGasto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/verde1"
            android:hint="Ingresa el nombre"
            android:inputType="text"
            android:textColor="@color/black"
            android:textSize="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCantidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/Meu2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad:"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCantidadGasto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/verde1"
            android:hint="Ingresa la cantidad"
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:textSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/layoutCantidad">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha:"
            android:textColor="@color/black"
            android:textSize="24dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFechaGasto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/verde1"
            android:hint="Ingresa la fecha"
            android:inputType="number"
            android:textColor="@color/black"
            android:textSize="18dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGuardarGasto"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:text="Guardar"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="24dp"
        app:backgroundTint="@color/verde3"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFecha" />

    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/verde2"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Inicio"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_casa"
            app:tint="@color/verde1" />

        <ImageButton
            android:id="@+id/navAgregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Agregar"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_mas"
            app:tint="@color/verde1" />

        <ImageButton
            android:id="@+id/navPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Perfil"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icono_persona"
            app:tint="@color/verde1" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>